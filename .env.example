APP_NAME=NutriTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Aiven MySQL: uncomment and set the local CA certificate path and password.
# DB_CONNECTION=mysql
# DB_HOST=mysql-1a83d774-chebbimed514-5300.e.aivencloud.com
# DB_PORT=12797
# DB_DATABASE=defaultdb
# DB_USERNAME=laravel_app
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA="C:/path/to/ca.pem"
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails de développement : boîte de test Mailtrap (identifiants dans Mailtrap > Sandboxes > SMTP, jamais commités)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@nutritrace.tn"
MAIL_FROM_NAME="NutriTrace"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary : photos des produits (identifiants à demander à l'équipe, ne jamais les committer)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini facultatif : un seul appel de résumé par analyse, jamais pour les prix/stocks
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=8

# Prévision Python Random Forest via le service local séparé
FORECAST_MODE=http
FORECAST_PYTHON=auto
FORECAST_FALLBACK=false
FORECAST_API_URL=http://127.0.0.1:8001/predict
FORECAST_API_TIMEOUT=15
# Google Gemini : IA du module Traçabilité (clé gratuite sur https://aistudio.google.com/apikey, ne jamais la committer)
GEMINI_MODELES_SECOURS=gemini-3.7-flash,gemini-flash-lite-latest
